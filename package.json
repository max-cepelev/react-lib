{
	"name": "@max-ts/kit",
	"version": "1.15.0",
	"main": "./lib/index.js",
	"module": "./lib/index.mjs",
	"types": "./lib/index.d.ts",
	"exports": {
		".": {
			"import": "./lib/index.mjs",
			"types": "./lib/index.d.ts"
		},
		"./form": {
			"import": "./lib/form.mjs",
